{
  "name": "wdworld",
  "version": "1.10.0",
  "description": "本地优先的世界观、小说、OC、TRPG 与酒馆创作工作台",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:desktop": "npm run build && node scripts/test-desktop.js",
    "test:studio": "npm run build && node scripts/test-studio-desktop.js",
    "test:world": "npm run build && node scripts/test-world-desktop.js",
    "test:automation": "npm run build && node scripts/test-automation-desktop.js",
    "test:plugins": "npm run build && node scripts/test-plugins-desktop.js",
    "preview": "vite preview",
    "desktop": "npm run build && node scripts/desktop.js",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "package": "npm run build && node scripts/package.js",
    "test:lan": "npm run build && node scripts/test-lan-desktop.js",
    "test:novel-desk": "npm run build && node scripts/test-novel-desk.js",
    "test:mode-homes": "npm run build && node scripts/test-mode-homes.js",
    "test:theme": "npm run build && node scripts/test-theme-desktop.js"
  },
  "build": {
    "appId": "com.wdworld.app",
    "productName": "WD World",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "WDWorld-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "actrox",
        "repo": "wdWorld",
        "releaseType": "release"
      }
    ],
    "extraFiles": [
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "*.md"
        ]
      }
    ]
  },
  "dependencies": {
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.6.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.11.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.18",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  }
}
